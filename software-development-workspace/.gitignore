# OS files
.DS_Store
Thumbs.db

# Editor and IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
!logs/
!logs/**/
!logs/**/*.log
!logs/**/*.md

# Environment and secrets
.env
.env.*
*.local
.venv/
venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
dist/
build/

# Compiled artifacts
*.o
*.so
*.dll
*.exe
*.class

# Temporary files
*.tmp
*.swp

# Database dumps. Kept on the host, never in the repository — they hold
# employee records, customer correspondence and payroll figures.
backups/*.dump
