# VS Code Server
.vscode-server/
.vscode-server-insiders/

# Copilot
.copilot/

# Cache directories
.cache/
.dotnet/
.net/
.npm/
.docker/
.local/
.config/
.lesshst
.sudo_as_admin_successful

# Claude Code config (may contain credentials)
.claude/
.claude.json

# Shell history
.bash_history
.bash_logout
.bash_profile
.bashrc
.profile

# Git / tool config living in $HOME
.gitconfig
.wget-hsts

# Database dumps (contain production HR data)
backups/

# Nested repos (managed separately)
PLM-Rebuild/
frappe_docker/
old plm/
plm v2/

# Local credential material — never commit
security/

# Browser certificate/key store — key4.db is a private key database
.pki/

# Large local archives that have no business in source control
archive*.zip
